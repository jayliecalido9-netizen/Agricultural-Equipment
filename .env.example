# Generate actual local passwords with scripts/Initialize-Environment.ps1.
POSTGRES_DB=agriconnect
POSTGRES_PORT=5432
POSTGRES_ADMIN_PASSWORD=
AEAMS_MIGRATOR_PASSWORD=
AEAMS_APP_PASSWORD=
# Used by Prisma migration CLI on the host. URL-encode passwords in URLs.
DATABASE_URL=postgresql://aeams_migrator:REPLACE_ME@localhost:5432/agriconnect?schema=aeams
APP_DATABASE_URL=postgresql://aeams_app:REPLACE_ME@localhost:5432/agriconnect?schema=aeams
# Explicit opt-in only. These credentials never belong in production.
ALLOW_DEMO_SEED=false
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=
JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_PORT=3000
COOKIE_SECURE=false
TRUST_PROXY_HOPS=1
PORT=5000
UPLOAD_DIRECTORY=uploads
INTEGRATION_ALLOWED_HOSTS=
# Live module credentials belong only on the server. No live adapter is enabled by default.
FFRMS_API_TOKEN=
APMS_API_TOKEN=
AISMS_API_TOKEN=
AASMS_API_TOKEN=
ABPMS_API_TOKEN=
